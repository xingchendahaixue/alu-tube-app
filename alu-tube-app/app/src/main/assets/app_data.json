 "weld_params": [
  {
   "序号": "1",
   "参数项目": "焊接频率",
   "关键数值/要点": "铝管300～800kHz（100kW设备600～700kHz，60kW设备700～800kHz）",
   "备注": ""
  },
  {
   "序号": "2",
   "参数项目": "焊接温度",
   "关键数值/要点": "3003铝 643～654℃（窗口仅11℃，宁欠勿过）",
   "备注": "温度窗口极窄，参数必须精细"
  },
  {
   "序号": "3",
   "参数项目": "温度判断",
   "关键数值/要点": "铝高温无可见色泽，靠黄白色铝飞屑判断：少量细密=合适，多而大=过烧，无飞屑=冷焊",
   "备注": ""
  },
  {
   "序号": "4",
   "参数项目": "会合角",
   "关键数值/要点": "≤7°",
   "备注": "由导向辊控制"
  },
  {
   "序号": "5",
   "参数项目": "焊缝间隙",
   "关键数值/要点": "1～3mm",
   "备注": ""
  },
  {
   "序号": "6",
   "参数项目": "挤压量",
   "关键数值/要点": "壁厚的1～3倍",
   "备注": ""
  },
  {
   "序号": "7",
   "参数项目": "感应圈",
   "关键数值/要点": "与管坯间隙3～5mm，宽度=(1.0～1.2)×管径；冷却水独立纯水回路",
   "备注": ""
  },
  {
   "序号": "8",
   "参数项目": "磁棒",
   "关键数值/要点": "截面积≥管内径截面积70%，需内水冷",
   "备注": ""
  },
  {
   "序号": "9",
   "参数项目": "模具间隙",
   "关键数值/要点": "圆管0.35mm / 扁管0.5mm / 校直0.7mm / 理论0.30mm",
   "备注": ""
  },
  {
   "序号": "10",
   "参数项目": "壁厚公差",
   "关键数值/要点": "±0.015mm",
   "备注": "进料必检"
  },
  {
   "序号": "11",
   "参数项目": "灯丝预热",
   "关键数值/要点": "先半灯丝5min → 全灯丝5min，共5～10min",
   "备注": "关机先关高频输出→灯丝冷却5min→再关水"
  },
  {
   "序号": "12",
   "参数项目": "飞剪",
   "关键数值/要点": "最快5次/秒；切口垂直度≤0.3mm",
   "备注": ""
  },
  {
   "序号": "13",
   "参数项目": "线能量公式",
   "关键数值/要点": "q = IU/v (J/mm)",
   "备注": "热量=电流×电压，与速度匹配"
  },
  {
   "序号": "14",
   "参数项目": "爆破压力公式",
   "关键数值/要点": "P = 2St/D",
   "备注": "P压力、t壁厚、D外径、S许用应力"
  },
  {
   "序号": "15",
   "参数项目": "轧制线成型法",
   "关键数值/要点": "本生产线采用上山成型法（第一架次至挤压辊高度递增）",
   "备注": "成型法由模具设计确定，垫片必须对应"
  },
  {
   "序号": "16",
   "参数项目": "调机铁律",
   "关键数值/要点": "一次只调一个参数，调完观察再调下一个",
   "备注": ""
  },
  {
   "序号": "17",
   "参数项目": "开机顺序",
   "关键数值/要点": "机组电源→操作台→内循环水→外循环水→乳化液→灯丝预热→飞剪归位→开气→感应圈水→安全检查后开机",
   "备注": "共10步，关机顺序相反"
  },
  {
   "序号": "18",
   "参数项目": "带料安装",
   "关键数值/要点": "穿料时钎焊面（4343层）必须朝下；点动速度5～10m/min",
   "备注": ""
  }
 ],
 "faults": [
  {
   "序号": "1",
   "故障现象": "虚焊/冷焊",
   "主要原因": "功率不足/速度快/挤压小",
   "处理方法": "升功率/降速/增大挤压量"
  },
  {
   "序号": "2",
   "故障现象": "过烧/烧熔",
   "主要原因": "功率过大/速度慢/加热区长",
   "处理方法": "降功率/提速/感应圈前移"
  },
  {
   "序号": "3",
   "故障现象": "搭焊/错边",
   "主要原因": "挤压辊窜动/轴承坏/孔型偏",
   "处理方法": "查锁紧/换轴承/重新找正"
  },
  {
   "序号": "4",
   "故障现象": "焊瘤过大",
   "主要原因": "挤压量大/功率大",
   "处理方法": "减挤压量/降功率/调刮刀"
  },
  {
   "序号": "5",
   "故障现象": "焊缝波纹",
   "主要原因": "会合角太大",
   "处理方法": "调导向辊减小会合角/提速"
  },
  {
   "序号": "6",
   "故障现象": "焊缝偏移",
   "主要原因": "带材跑偏/辊位偏",
   "处理方法": "调对中/重新找正各辊"
  },
  {
   "序号": "7",
   "故障现象": "表面压痕",
   "主要原因": "上辊压下量大/辊面缺陷",
   "处理方法": "减压下量/扩大后跟隙/修磨辊面"
  },
  {
   "序号": "8",
   "故障现象": "爆破压力不够",
   "主要原因": "挤压量小/电压低/对缝差",
   "处理方法": "调挤压量/调输出电压/调对缝"
  },
  {
   "序号": "9",
   "故障现象": "侧向弯曲",
   "主要原因": "校直平辊偏",
   "处理方法": "调侧向校直平辊"
  },
  {
   "序号": "10",
   "故障现象": "平面弯曲",
   "主要原因": "校直立辊偏",
   "处理方法": "调平面校直立辊"
  },
  {
   "序号": "11",
   "故障现象": "涡流误报",
   "主要原因": "探头偏心/振动大/增益高",
   "处理方法": "重新对中/加导向/降增益"
  },
  {
   "序号": "12",
   "故障现象": "涡流漏报",
   "主要原因": "增益低/相位错/探头磨损",
   "处理方法": "提增益/调相位/换探头"
  },
  {
   "序号": "13",
   "故障现象": "清洗后水膜不连续",
   "主要原因": "油污残留/脱脂剂失效",
   "处理方法": "提浓度/升温/换脱脂剂"
  },
  {
   "序号": "14",
   "故障现象": "清洗后水渍白斑",
   "主要原因": "非纯水漂洗/吹干不足",
   "处理方法": "改用纯水/提吹干温度风量"
  },
  {
   "序号": "15",
   "故障现象": "焊缝不对中",
   "主要原因": "成型部位轮子直线度差",
   "处理方法": "检查成型部位所有轮子的直线度"
  },
  {
   "序号": "16",
   "故障现象": "焊缝毛刺大或刮伤",
   "主要原因": "刮刀深度不当",
   "处理方法": "调整刮刀深度"
  },
  {
   "序号": "17",
   "故障现象": "表面划伤、压痕",
   "主要原因": "模具成型量不当",
   "处理方法": "检查模具的成型量"
  }
